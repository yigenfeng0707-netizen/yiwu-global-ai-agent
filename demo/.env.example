# 后端配置
PORT=8000
HOST=0.0.0.0
# CORS允许的前端域名（生产环境必填，逗号分隔多个域名）
# ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-custom-domain.com

# LLM大模型配置（OpenAI兼容模式，支持任意兼容网关）
# 当前线上使用：阶跃星辰 step-3.7-flash（注意：推理模型，max_tokens 建议 ≥300）
# 也可切换：阿里云百炼 https://dashscope.aliyuncs.com/compatible-mode/v1 (qwen-plus)
LLM_BASE_URL=https://api.stepfun.com/step_plan/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=step-3.7-flash
# 网关特有请求参数（JSON，合并进请求体；如阶跃的推理力度控制）
# LLM_REQUEST_EXTRAS={"reasoning_effort":"low"}
# LLM每日调用上限（防止token被恶意消耗，0=不限制）
LLM_DAILY_LIMIT=500

# 阿里云百炼工作空间配置
DASHSCOPE_WORKSPACE_ID=your-workspace-id-here

# API请求签名密钥（前后端共享，防止第三方直接调用API）
# 不设置则跳过签名验证（仅开发模式使用）
# API_SECRET=your-random-secret-key-here

# JWT鉴权密钥（配置后LLM消耗接口需登录才能使用）
# 不设置则跳过鉴权（仅开发模式使用）
# JWT_SECRET=your-jwt-secret-key-here

# 数据库配置（SQLite持久化 - 用户/会话/查询历史）
# DATABASE_PATH=./data/app.db
