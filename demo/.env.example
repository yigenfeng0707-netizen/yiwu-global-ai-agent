# 后端配置
PORT=8000
HOST=0.0.0.0
# CORS允许的前端域名（生产环境必填，逗号分隔多个域名）
# ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-custom-domain.com

# LLM大模型配置（阿里云百炼DashScope - OpenAI兼容模式）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=qwen-plus
# LLM每日调用上限（防止token被恶意消耗，0=不限制）
LLM_DAILY_LIMIT=500

# 阿里云百炼工作空间配置
DASHSCOPE_WORKSPACE_ID=your-workspace-id-here

# API请求签名密钥（前后端共享，防止第三方直接调用API）
# 不设置则跳过签名验证（仅开发模式使用）
# API_SECRET=your-random-secret-key-here

# JWT鉴权密钥（配置后LLM消耗接口需登录才能使用）
# 不设置则跳过鉴权（仅开发模式使用）
# JWT_SECRET=your-jwt-secret-key-here

# ============ 金漪湖论剑 OPC 智能体赛道 · 官方工具 remio 睿妙 ============
# 知识库目录：将 remio 导出的知识（markdown）放入此目录，Agent 将优先据此检索，
# 实现"使用官方工具 remio 构建知识库"。留空则仅用内置数据。
REMIO_KB_DIR=app/knowledge/remio_export
# 是否启用 remio 知识库检索（true/false）
REMIO_KB_ENABLED=true
# 运行时是否实时调用 remio CLI 检索（auto=自动探测 / true=强制 / false=仅用本地副本）
# auto 会在检测到 remio 桌面端运行时，直接通过 CLI 语义检索官方知识库（最强"使用官方工具"证明）
REMIO_LIVE_CLI=auto
# remio CLI 可执行文件路径（留空则自动探测 remio-cli / remiocn）
# REMIO_CLI_PATH=C:\Users\18969\AppData\Local\Programs\remio-cli\remio.exe

# ============ 竞品实采工具（智能体自主性 / 工具调用） ============
# 是否在市场洞察中调用真实浏览器调研竞品（true/false）。默认关闭以保持管线快速稳定。
ENABLE_LIVE_COMPETITOR=0
# 竞品实采总开关（true/false）。关闭时接口返回带明确标识的模拟数据。
COMPETITOR_RESEARCH_ENABLED=true
# 复用本地 WebRetriever Agent 需将其所在目录加入 PYTHONPATH：
# 例：PYTHONPATH=D:\Apps\competition\webretriever-agent
