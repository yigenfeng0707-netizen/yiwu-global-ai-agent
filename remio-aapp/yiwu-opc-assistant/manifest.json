          "presentation": "chat"
        }
      },
      {
        "label": "竞品实采（自主抓网页）",
        "action": {
          "prompt": "请竞品实采：无线耳机",
          "presentation": "chat"
        }
      },
      {
        "label": "智能选品推荐",
        "action": {
          "prompt": "帮我做智能选品推荐",
          "presentation": "chat"
        }
      },
      {
        "label": "跨境合规检查",
        "action": {
          "prompt": "帮我做跨境合规检查",
          "presentation": "chat"
        }
      },
      {
        "label": "政策复制与金义新区落地",
        "action": {
          "prompt": "如何做政策复制与金义新区落地",
          "presentation": "chat"
        }
      }
    ]
  },
  "runtime": {
    "type": "embedded"
